# Static file server for yak-shave.com.
#
# TLS is terminated by Cloudflare and traffic arrives through the tunnel and
# Traefik, so this speaks plain HTTP on an unprivileged port and does nothing
# clever.
:8080 {
	root * /srv
	encode zstd gzip

	# HTML is short-lived because a republish reuses the same URLs. Astro's
	# assets are content-hashed, so they can be cached forever.
	#
	# The two matchers are mutually exclusive on purpose: an unmatched
	# `header` plus a path-matched one both apply to an asset request, and the
	# broader rule wins, silently capping assets at the short TTL.
	@assets path /_astro/*
	@pages not path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @pages Cache-Control "public, max-age=300"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Astro emits directory-style URLs (/blog/<slug>/index.html).
	try_files {path} {path}/index.html {path}.html
	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}
}
