# Static file server for yak-shave.com.
#
# TLS is terminated by Cloudflare and traffic arrives through the tunnel and
# Traefik, so this speaks plain HTTP on an unprivileged port and does nothing
# clever.
:8080 {
	root * /srv
	encode zstd gzip

	# HTML is short-lived because a republish reuses the same URLs. Astro's
	# assets are content-hashed, so they can be cached forever.
	#
	# The two matchers are mutually exclusive on purpose: an unmatched
	# `header` plus a path-matched one both apply to an asset request, and the
	# broader rule wins, silently capping assets at the short TTL.
	@assets path /assets/*
	@pages not path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header @pages Cache-Control "public, max-age=300"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Generated at build time by the latest-post-redirect integration: / goes
	# to the newest post's own URL, so the fragment links on the front page
	# cannot rot when a newer post takes its place.
	import /etc/caddy/latest.caddy

	# Astro emits directory-style URLs (/<slug>/index.html).
	try_files {path} {path}/index.html {path}.html
	file_server

	handle_errors {
		# Never let an error inherit the immutable asset header above. That
		# header is chosen by request path, so a 404 on a hashed asset path
		# would carry max-age=31536000 - and a transient 404 (a rollout
		# serving new HTML from one pod and old files from another) would be
		# cached by Cloudflare for a year, pinning the site unstyled.
		header Cache-Control "no-store"
		rewrite * /404.html
		file_server
	}
}
