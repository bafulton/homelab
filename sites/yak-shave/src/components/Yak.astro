---
/**
 * The nameplate yak.
 *
 * A solid silhouette rather than line art: this is a one-ink page, and a
 * woodcut mark is what a one-ink press would have put at the top of it. It
 * fills with currentColor so it inverts with the theme for free; the eye is
 * punched out in --paper for the same reason.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="58 36 390 226"
  role="img"
  aria-label="A shaggy yak"
  fill="currentColor"
>
  <path d="M 188 206 C 186 224 184 240 186 254 L 206 254 C 206 240 208 224 210 206 Z" />
