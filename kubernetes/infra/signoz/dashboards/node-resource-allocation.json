      "cpu-by-ns": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Total CPU requests committed per namespace (in cores). Multiply by 1000 for millicores.",
            "name": "CPU Requests by Namespace (cores)"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 0,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "none"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "aggregations": [
                      {
                        "metricName": "kube_pod_container_resource_requests",
                        "reduceTo": "sum",
                        "spaceAggregation": "sum",
                        "temporality": "",
                        "timeAggregation": "latest"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "resource = 'cpu'"
                    },
                    "functions": [],
                    "groupBy": [
                      {
                        "fieldContext": "attribute",
                        "fieldDataType": "string",
                        "name": "namespace",
                        "signal": ""
                      }
                    ],
                    "having": {
                      "expression": ""
                    },
                    "legend": "{{namespace}}",
                    "name": "A",
                    "order": [],
                    "signal": "metrics",
                    "source": ""
                  }
                }
              }
            }
          ]
        }
      },
