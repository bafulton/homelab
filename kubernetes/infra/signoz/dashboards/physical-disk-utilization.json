          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
                    "legend": "{{k8s.node.name}} {{device}}",
                    "name": "A",
                    "query": "smartctl_device_percentage_used",
                    "stats": false,
                    "step": 0
                  }
                }
