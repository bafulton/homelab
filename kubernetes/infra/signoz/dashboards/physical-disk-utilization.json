      "system-pct": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Percentage of /var partition used per node",
            "name": "System Drive Usage %"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
