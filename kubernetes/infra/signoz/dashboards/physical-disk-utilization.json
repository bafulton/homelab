                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": [
                {
                  "color": "Red",
                  "label": "",
                  "unit": "none",
                  "value": 1
                }
              ],
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
