    "links": [],
    "panels": {
      "all-fs-bytes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Used bytes for all non-virtual filesystems (excludes tmpfs, devtmpfs, overlay) across all nodes",
            "name": "All Physical Filesystem Usage"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 0,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "bytes"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
                    "legend": "{{k8s.node.name}} {{mountpoint}} ({{type}})",
                    "name": "A",
                    "query": "sum by (\"k8s.node.name\", mountpoint, type) ({\"system.filesystem.usage\", state=\"used\", type!=\"tmpfs\", type!=\"devtmpfs\", type!=\"overlay\"})",
                    "stats": false,
                    "step": 0
                  }
                }
              }
            }
          ]
        }
      },
      "longhorn-bytes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Bytes used in Longhorn managed disks per node",
            "name": "Longhorn Disk Usage"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 0,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "bytes"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
                    "legend": "{{node}} / {{disk}}",
                    "name": "A",
                    "query": "sum by (node, disk) (longhorn_disk_usage_bytes)",
                    "stats": false,
                    "step": 0
                  }
                }
              }
            }
          ]
        }
      },
      "longhorn-pct": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Percentage of Longhorn disk capacity used per node",
            "name": "Longhorn Disk Usage %"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 100,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "percent"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": [
                {
                  "color": "Yellow",
                  "label": "",
                  "unit": "percent",
                  "value": 80
                },
                {
                  "color": "Red",
                  "label": "",
                  "unit": "percent",
                  "value": 90
                }
              ],
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
                    "legend": "{{node}} / {{disk}}",
                    "name": "A",
                    "query": "sum by (node, disk) (longhorn_disk_usage_bytes) / sum by (node, disk) (longhorn_disk_capacity_bytes) * 100",
                    "stats": false,
                    "step": 0
                  }
                }
              }
            }
          ]
        }
      },
      "smart-errors": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "NVMe media errors and error log entry count. Both should be 0 at all times — any increase indicates drive damage or firmware issues.",
            "name": "NVMe Errors (should be 0)"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": null,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "none"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": [
                {
                  "color": "Red",
                  "label": "",
                  "unit": "none",
                  "value": 0
                }
              ],
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "spec": {
                          "disabled": false,
                          "legend": "{{k8s.node.name}} {{device}} media errors",
                          "name": "A",
                          "query": "smartctl_device_media_errors",
                          "stats": false,
                          "step": 0
                        },
                        "type": "promql"
                      },
                      {
                        "spec": {
                          "disabled": false,
                          "legend": "{{k8s.node.name}} {{device}} error log entries",
                          "name": "B",
                          "query": "smartctl_device_num_err_log_entries",
                          "stats": false,
                          "step": 0
                        },
                        "type": "promql"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "smart-spare": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Available spare NVMe blocks (%) vs the drive's built-in critical threshold. Spare dropping below threshold indicates imminent block exhaustion.",
            "name": "Available Spare Blocks"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 100,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "percent"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": [
                {
                  "color": "Red",
                  "label": "",
                  "unit": "percent",
                  "value": 10
                }
              ],
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "spec": {
                          "disabled": false,
                          "legend": "{{k8s.node.name}} {{device}} spare",
                          "name": "A",
                          "query": "smartctl_device_available_spare",
                          "stats": false,
                          "step": 0
                        },
                        "type": "promql"
                      },
                      {
                        "spec": {
                          "disabled": false,
                          "legend": "{{k8s.node.name}} {{device}} threshold",
                          "name": "B",
                          "query": "smartctl_device_available_spare_threshold",
                          "stats": false,
                          "step": 0
                        },
                        "type": "promql"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "smart-status": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "SMART overall self-assessment: 1 = PASSED, 0 = FAILED. A value of 0 means the drive has reported a critical health failure.",
            "name": "SMART Status (1=OK, 0=FAILED)"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 1,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
