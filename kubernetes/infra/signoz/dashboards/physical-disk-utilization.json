              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": [
                {
                  "color": "Yellow",
                  "label": "",
                  "unit": "percent",
                  "value": 80
                },
                {
                  "color": "Red",
                  "label": "",
                  "unit": "percent",
                  "value": 90
                }
              ],
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
