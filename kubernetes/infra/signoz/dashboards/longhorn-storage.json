{
  "schemaVersion": "v6",
  "tags": [
    {
      "key": "tag",
      "value": "gitops"
    }
  ],
  "spec": {
    "display": {
      "description": "Longhorn distributed storage — cluster capacity, per-volume usage, node storage, I/O performance, and replica health",
      "name": "Longhorn - Storage"
    },
    "duration": "",
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "collapse": {
              "open": true
            },
            "title": "Storage Overview"
