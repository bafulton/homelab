          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/stat-capacity"
              },
              "height": 4,
              "width": 3,
              "x": 0,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/stat-used"
              },
              "height": 4,
              "width": 3,
              "x": 3,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/stat-usage-pct"
              },
              "height": 4,
              "width": 3,
              "x": 6,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/stat-volumes"
              },
              "height": 4,
              "width": 3,
              "x": 9,
              "y": 0
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "collapse": {
              "open": true
            },
            "title": "Volume Usage"
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/graph-volume-sizes"
              },
              "height": 7,
              "width": 6,
              "x": 0,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/graph-volume-usage-pct"
              },
              "height": 7,
              "width": 6,
              "x": 6,
              "y": 0
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "collapse": {
              "open": true
            },
            "title": "Node Storage"
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/graph-node-storage"
              },
              "height": 7,
              "width": 6,
              "x": 0,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/graph-node-storage-pct"
              },
              "height": 7,
              "width": 6,
              "x": 6,
              "y": 0
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "collapse": {
              "open": true
            },
            "title": "Volume I/O"
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/graph-iops"
              },
              "height": 6,
              "width": 6,
              "x": 0,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/graph-latency"
              },
              "height": 6,
              "width": 6,
              "x": 6,
              "y": 0
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "collapse": {
              "open": true
            },
            "title": "Health"
          },
          "items": [
            {
              "content": {
                "$ref": "#/spec/panels/graph-replica-state"
              },
              "height": 6,
              "width": 6,
              "x": 0,
              "y": 0
            },
            {
              "content": {
                "$ref": "#/spec/panels/graph-disk-health"
              },
              "height": 6,
              "width": 6,
              "x": 6,
              "y": 0
            }
          ]
        }
      }
    ],
    "links": [],
    "panels": {
      "graph-disk-health": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Longhorn disk status per node/disk (1 = schedulable, 0 = unschedulable)",
            "name": "Disk Schedulability"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 1,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "none"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
                    "legend": "{{node}} / {{disk}}",
                    "name": "A",
                    "query": "sum by (node, disk) (longhorn_disk_status)",
                    "stats": false,
                    "step": 0
                  }
                }
              }
            }
          ]
        }
      },
      "graph-iops": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Read and write IOPS per Longhorn volume",
            "name": "Volume IOPS"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 0,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "none"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "spec": {
                          "disabled": false,
                          "legend": "{{volume}} read",
                          "name": "A",
                          "query": "sum by (volume) (longhorn_volume_read_iops)",
                          "stats": false,
                          "step": 0
                        },
                        "type": "promql"
                      },
                      {
                        "spec": {
                          "disabled": false,
                          "legend": "{{volume}} write",
                          "name": "B",
                          "query": "sum by (volume) (longhorn_volume_write_iops)",
                          "stats": false,
                          "step": 0
                        },
                        "type": "promql"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "graph-latency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Read and write latency per Longhorn volume (nanoseconds)",
            "name": "Volume Latency"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 0,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "ns"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "spec": {
                          "disabled": false,
                          "legend": "{{volume}} read",
                          "name": "A",
                          "query": "sum by (volume) (longhorn_volume_read_latency)",
                          "stats": false,
                          "step": 0
                        },
                        "type": "promql"
                      },
                      {
                        "spec": {
                          "disabled": false,
                          "legend": "{{volume}} write",
                          "name": "B",
                          "query": "sum by (volume) (longhorn_volume_write_latency)",
                          "stats": false,
                          "step": 0
                        },
                        "type": "promql"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "graph-node-storage": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Longhorn storage used and scheduled per node",
            "name": "Node Storage Usage"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 0,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "bytes"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "spec": {
                          "disabled": false,
                          "legend": "{{node}} used",
                          "name": "A",
                          "query": "sum by (node) (longhorn_node_storage_usage_bytes)",
                          "stats": false,
                          "step": 0
                        },
                        "type": "promql"
                      },
                      {
                        "spec": {
                          "disabled": false,
                          "legend": "{{node}} scheduled",
                          "name": "B",
                          "query": "sum by (node) (longhorn_node_storage_scheduled_bytes)",
                          "stats": false,
                          "step": 0
                        },
                        "type": "promql"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "graph-node-storage-pct": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Percentage of Longhorn capacity used per node",
            "name": "Node Storage Usage %"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 100,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "percent"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": [
                {
                  "color": "Yellow",
                  "label": "",
                  "unit": "percent",
                  "value": 70
                },
                {
                  "color": "Red",
                  "label": "",
                  "unit": "percent",
                  "value": 85
                }
              ],
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
                    "legend": "{{node}}",
                    "name": "A",
                    "query": "sum by (node) (longhorn_node_storage_usage_bytes) / sum by (node) (longhorn_node_storage_capacity_bytes) * 100",
                    "stats": false,
                    "step": 0
                  }
                }
              }
            }
          ]
        }
      },
      "graph-replica-state": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Count of running vs non-running Longhorn replicas per volume",
            "name": "Replica States"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 0,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "none"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "spec": {
                          "disabled": false,
                          "legend": "{{volume}} running",
                          "name": "A",
                          "query": "count by (volume) (longhorn_replica_state == 1)",
                          "stats": false,
                          "step": 0
                        },
                        "type": "promql"
                      },
                      {
                        "spec": {
                          "disabled": false,
                          "legend": "{{volume}} non-running",
                          "name": "B",
                          "query": "count by (volume) (longhorn_replica_state != 1)",
                          "stats": false,
                          "step": 0
                        },
                        "type": "promql"
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "graph-volume-sizes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Replica data on disk per volume (namespace/PVC). Includes snapshot differentials — this is storage consumed on the node, not filesystem utilization inside the volume.",
            "name": "Volume Actual Size by PVC"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 0,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "bytes"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": null,
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
                    "legend": "{{pvc_namespace}}/{{pvc}}",
                    "name": "A",
                    "query": "sum by (pvc, pvc_namespace) (longhorn_volume_actual_size_bytes)",
                    "stats": false,
                    "step": 0
                  }
                }
              }
            }
          ]
        }
      },
      "graph-volume-usage-pct": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Replica data on disk as a percentage of provisioned capacity. Values over 100% are normal when snapshots are present — snapshot differentials accumulate alongside live data. This is not filesystem utilization.",
            "name": "Volume Usage %"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "axes": {
                "isLogScale": false,
                "softMax": 100,
                "softMin": 0
              },
              "chartAppearance": {
                "fillMode": "none",
                "lineInterpolation": "spline",
                "lineStyle": "solid",
                "showPoints": false,
                "spanGaps": {
                  "fillLessThan": "",
                  "fillOnlyBelow": false
                }
              },
              "formatting": {
                "decimalPrecision": "2",
                "unit": "percent"
              },
              "legend": {
                "customColors": null,
                "mode": "list",
                "position": "bottom"
              },
              "thresholds": [
                {
                  "color": "Yellow",
                  "label": "",
                  "unit": "percent",
                  "value": 70
                },
                {
                  "color": "Red",
                  "label": "",
                  "unit": "percent",
                  "value": 85
                }
              ],
              "visualization": {
                "fillSpans": false,
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
                    "legend": "{{pvc_namespace}}/{{pvc}}",
                    "name": "A",
                    "query": "sum by (pvc, pvc_namespace) (longhorn_volume_actual_size_bytes) / sum by (pvc, pvc_namespace) (longhorn_volume_capacity_bytes) * 100",
                    "stats": false,
                    "step": 0
                  }
                }
              }
            }
          ]
        }
      },
      "stat-capacity": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Total Longhorn storage capacity across all nodes",
            "name": "Cluster Capacity"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "decimalPrecision": "2",
                "unit": "bytes"
              },
              "thresholds": [
                {
                  "color": "Blue",
                  "format": "text",
                  "operator": "above",
                  "unit": "none",
                  "value": 0
                }
              ],
              "visualization": {
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
                    "legend": "",
                    "name": "A",
                    "query": "sum(longhorn_node_storage_capacity_bytes)",
                    "stats": false,
                    "step": 0
                  }
                }
              }
            }
          ]
        }
      },
      "stat-usage-pct": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Percentage of total Longhorn capacity in use",
            "name": "Cluster Usage %"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "decimalPrecision": "2",
                "unit": "percent"
              },
              "thresholds": [
                {
                  "color": "Green",
                  "format": "text",
                  "operator": "above",
                  "unit": "none",
                  "value": 0
                },
                {
                  "color": "Yellow",
                  "format": "text",
                  "operator": "above",
                  "unit": "none",
                  "value": 70
                },
                {
                  "color": "Red",
                  "format": "text",
                  "operator": "above",
                  "unit": "none",
                  "value": 85
                }
              ],
              "visualization": {
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
                    "legend": "",
                    "name": "A",
                    "query": "sum(longhorn_node_storage_usage_bytes) / sum(longhorn_node_storage_capacity_bytes) * 100",
                    "stats": false,
                    "step": 0
                  }
                }
              }
            }
          ]
        }
      },
      "stat-used": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Total replica data stored on disk across all Longhorn nodes. Includes snapshot differentials, so may exceed provisioned capacity when snapshots are present.",
            "name": "Storage Used"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "decimalPrecision": "2",
                "unit": "bytes"
              },
              "thresholds": [
                {
                  "color": "Blue",
                  "format": "text",
                  "operator": "above",
                  "unit": "none",
                  "value": 0
                }
              ],
              "visualization": {
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
                    "legend": "",
                    "name": "A",
                    "query": "sum(longhorn_node_storage_usage_bytes)",
                    "stats": false,
                    "step": 0
                  }
                }
              }
            }
          ]
        }
      },
      "stat-volumes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "Total number of Longhorn volumes",
            "name": "Volumes"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "formatting": {
                "decimalPrecision": "2",
                "unit": "none"
              },
              "thresholds": [
                {
                  "color": "Blue",
                  "format": "text",
                  "operator": "above",
                  "unit": "none",
                  "value": 0
                }
              ],
              "visualization": {
                "timePreference": "global_time"
              }
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "disabled": false,
                    "legend": "",
                    "name": "A",
                    "query": "count(longhorn_volume_capacity_bytes)",
                    "stats": false,
                    "step": 0
                  }
                }
              }
            }
          ]
        }
      }
    },
    "refreshInterval": "",
    "variables": []
  }
}
