      "644b2494-167e-43b4-8e0c-4def97cdcce4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "",
            "name": "Is my cluser,node,namespace sending metric?"
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TablePanel",
            "spec": {
              "formatting": {
                "columnUnits": null,
                "decimalPrecision": "2"
