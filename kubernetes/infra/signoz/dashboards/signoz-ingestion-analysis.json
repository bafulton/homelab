          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/ClickHouseSQL",
                  "spec": {
                    "disabled": false,
                    "legend": "",
                    "name": "A",
                    "query": "SELECT metric_name AS \"Normalized Metric Name\", `k8s.cluster.name` AS \"K8s Cluster Name\", `k8s.node.name` AS \"K8s Node Name\", `k8s.namespace.name` AS \"K8s Namespace Name\", if(count() > 0, 'Yes', 'No') AS \"Has Data\" FROM signoz_metrics.distributed_samples_v4 INNER JOIN (SELECT DISTINCT fingerprint, JSONExtractString(labels, 'k8s.cluster.name') AS `k8s.cluster.name`, JSONExtractString(labels, 'k8s.node.name') AS `k8s.node.name`, JSONExtractString(labels, 'k8s.namespace.name') AS `k8s.namespace.name` FROM signoz_metrics.time_series_v4_1day WHERE (metric_name NOT LIKE 'signoz_%') AND (metric_name NOT LIKE 'chi_%') AND (unix_milli >= intDiv($start_timestamp_ms, 86400000) * 86400000) AND (unix_milli < $end_timestamp_ms)) AS filtered_time_series USING fingerprint WHERE unix_milli >= toUnixTimestamp(now() - INTERVAL 15 MINUTE) * 1000 GROUP BY metric_name, `k8s.cluster.name`, `k8s.node.name`, `k8s.namespace.name` ORDER BY metric_name DESC, `k8s.cluster.name` DESC, `k8s.node.name` DESC, `k8s.namespace.name` DESC"
                  }
                }
              }
            }
          ]
        }
      },
