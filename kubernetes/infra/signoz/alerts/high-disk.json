{
  "schemaVersion": "v2alpha1",
  "alert": "High Disk Usage",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "threshold_rule",
  "disabled": false,
  "description": "Longhorn disk usage is above 85%",
  "summary": "High disk usage detected",
  "labels": {
    "source": "gitops",
    "severity": "critical"
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m0s",
      "frequency": "1m0s"
    }
  },
  "notificationSettings": {
    "renotify": {
      "enabled": true,
      "interval": "4h",
      "alertStates": [
        "firing"
      ]
    },
    "usePolicy": false
  },
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "stepInterval": 60,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "longhorn_disk_usage_bytes",
                "temporality": "",
                "timeAggregation": "avg",
                "spaceAggregation": "avg",
                "reduceTo": ""
              }
            ],
            "disabled": true,
            "filter": {
              "expression": ""
            },
            "groupBy": [
              {
                "name": "node",
                "signal": "",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              },
              {
                "name": "disk",
                "signal": "",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              }
            ],
            "having": {
              "expression": ""
            }
          }
        },
        {
          "type": "builder_query",
          "spec": {
            "name": "B",
            "stepInterval": 60,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "longhorn_disk_capacity_bytes",
                "temporality": "",
                "timeAggregation": "avg",
                "spaceAggregation": "avg",
                "reduceTo": ""
              }
            ],
            "disabled": true,
            "filter": {
              "expression": ""
            },
            "groupBy": [
              {
                "name": "node",
                "signal": "",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              },
              {
                "name": "disk",
                "signal": "",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              }
            ],
            "having": {
              "expression": ""
            }
          }
        },
        {
          "type": "builder_formula",
          "spec": {
            "name": "F1",
            "expression": "(A/B)*100",
            "legend": "{{node}}: {{disk}}"
          }
        }
      ],
      "panelType": "graph",
      "queryType": "builder"
    },
    "selectedQueryName": "F1",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 85,
          "op": "above",
          "matchType": "at_least_once",
          "channels": [
            "Email"
          ]
        }
      ]
    }
  }
}
