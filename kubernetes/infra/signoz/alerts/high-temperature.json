{
  "schemaVersion": "v2alpha1",
  "alert": "High Node Temperature",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "threshold_rule",
  "disabled": false,
  "description": "Node temperature is above 85°C",
  "summary": "High temperature detected on node",
  "labels": {
    "source": "gitops",
    "severity": "warning"
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m0s",
      "frequency": "1m0s"
    }
  },
  "notificationSettings": {
    "renotify": {
      "enabled": true,
      "interval": "4h",
      "alertStates": [
        "firing"
      ]
    },
    "usePolicy": false
  },
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "stepInterval": 60,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "node_hwmon_temp_celsius",
                "temporality": "",
                "timeAggregation": "max",
                "spaceAggregation": "max",
                "reduceTo": ""
              }
            ],
            "disabled": false,
            "filter": {
              "expression": ""
            },
            "groupBy": [
              {
                "name": "instance",
                "signal": "",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              }
            ],
            "having": {
              "expression": ""
            }
          }
        }
      ],
      "panelType": "graph",
      "queryType": "builder"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "warning",
          "target": 85,
          "op": "above",
          "matchType": "at_least_once",
          "channels": [
            "Email"
          ]
        }
      ]
    }
  }
}
