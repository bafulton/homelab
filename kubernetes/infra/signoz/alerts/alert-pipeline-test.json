{
  "schemaVersion": "v2alpha1",
  "alert": "SigNoz Alerting Pipeline Down",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "threshold_rule",
  "disabled": false,
  "description": "No k8s.node.cpu.usage data for 10+ minutes. SigNoz metrics ingestion or the alerting pipeline is broken.",
  "summary": "SigNoz alerting pipeline is DOWN",
  "labels": {
    "source": "gitops",
    "severity": "critical"
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m0s",
      "frequency": "1m0s"
    }
  },
  "notificationSettings": {
    "renotify": {
      "enabled": false
    },
    "usePolicy": false
  },
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "stepInterval": 60,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "k8s.node.cpu.usage",
                "temporality": "",
                "timeAggregation": "avg",
                "spaceAggregation": "avg",
                "reduceTo": ""
              }
            ],
            "disabled": false,
            "filter": {
              "expression": ""
            },
            "groupBy": [],
            "having": {
              "expression": ""
            },
            "legend": "cpu.usage"
          }
        }
      ],
      "panelType": "graph",
      "queryType": "builder"
    },
    "selectedQueryName": "A",
    "alertOnAbsent": true,
    "absentFor": 10,
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 1000000,
          "op": "above",
          "matchType": "at_least_once",
          "channels": [
            "Email"
          ]
        }
      ]
    }
  }
}
