{
  "schemaVersion": "v2alpha1",
  "alert": "High Memory Usage",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "threshold_rule",
  "disabled": false,
  "description": "Node memory usage is above 95%",
  "summary": "High memory usage detected",
  "labels": {
    "source": "gitops",
    "severity": "warning"
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "10m0s",
      "frequency": "1m0s"
    }
  },
  "notificationSettings": {
    "renotify": {
      "enabled": false
    },
    "usePolicy": false
  },
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "stepInterval": 60,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "k8s.node.memory.working_set",
                "temporality": "",
                "timeAggregation": "avg",
                "spaceAggregation": "avg",
                "reduceTo": ""
              }
            ],
            "disabled": true,
            "filter": {
              "expression": ""
            },
            "groupBy": [
              {
                "name": "k8s.node.name",
                "signal": "",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              }
            ],
            "having": {
              "expression": ""
            }
          }
        },
        {
          "type": "builder_query",
          "spec": {
            "name": "B",
            "stepInterval": 60,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "k8s.node.allocatable_memory",
                "temporality": "",
                "timeAggregation": "avg",
                "spaceAggregation": "avg",
                "reduceTo": ""
              }
            ],
            "disabled": true,
            "filter": {
              "expression": ""
            },
            "groupBy": [
              {
                "name": "k8s.node.name",
                "signal": "",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              }
            ],
            "having": {
              "expression": ""
            }
          }
        },
        {
          "type": "builder_formula",
          "spec": {
            "name": "F1",
            "expression": "(A/B)*100",
            "legend": "{{k8s.node.name}}"
          }
        }
      ],
      "panelType": "graph",
      "queryType": "builder"
    },
    "selectedQueryName": "F1",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "warning",
          "target": 95,
          "op": "above",
          "matchType": "on_average",
          "channels": [
            "Email"
          ]
        }
      ]
    }
  }
}
