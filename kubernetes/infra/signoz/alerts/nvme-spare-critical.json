{
  "schemaVersion": "v2alpha1",
  "alert": "NVMe Spare Below Threshold",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "threshold_rule",
  "disabled": false,
  "description": "NVMe available spare capacity is below 10% — drive has exhausted most spare blocks and may fail soon",
  "summary": "NVMe spare capacity critical on {{k8s.node.name}} ({{device}})",
  "labels": {
    "source": "gitops",
    "severity": "critical"
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m0s",
      "frequency": "5m0s"
    }
  },
  "notificationSettings": {
    "renotify": {
      "enabled": false
    },
    "usePolicy": false
  },
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "stepInterval": 300,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "smartctl_device_available_spare",
                "temporality": "",
                "timeAggregation": "min",
                "spaceAggregation": "min",
                "reduceTo": ""
              }
            ],
            "disabled": false,
            "filter": {
              "expression": ""
            },
            "groupBy": [
              {
                "name": "k8s.node.name",
                "signal": "",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              },
              {
                "name": "device",
                "signal": "",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              }
            ],
            "having": {
              "expression": ""
            },
            "legend": "{{k8s.node.name}} - {{device}}"
          }
        }
      ],
      "panelType": "graph",
      "queryType": "builder"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 10,
          "op": "below",
          "matchType": "all_the_times",
          "channels": [
            "Email"
          ]
        }
      ]
    }
  }
}
