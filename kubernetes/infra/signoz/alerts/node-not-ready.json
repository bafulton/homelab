{
  "schemaVersion": "v2alpha1",
  "alert": "Node Not Ready",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "threshold_rule",
  "disabled": false,
  "description": "Kubernetes node is not in Ready state",
  "summary": "Node not ready",
  "labels": {
    "source": "gitops",
    "severity": "critical"
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m0s",
      "frequency": "1m0s"
    }
  },
  "notificationSettings": {
    "renotify": {
      "enabled": false
    },
    "usePolicy": false
  },
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "stepInterval": 60,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "k8s.node.condition",
                "temporality": "",
                "timeAggregation": "latest",
                "spaceAggregation": "min",
                "reduceTo": ""
              }
            ],
            "disabled": false,
            "filter": {
              "expression": "condition != 'Ready'"
            },
            "groupBy": [
              {
                "name": "k8s.node.name",
                "signal": "",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              }
            ],
            "having": {
              "expression": ""
            },
            "legend": "{{k8s.node.name}}"
          }
        }
      ],
      "panelType": "graph",
      "queryType": "builder"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 0,
          "op": "above",
          "matchType": "all_the_times",
          "channels": [
            "Email"
          ]
        }
      ]
    }
  }
}
