{
  "schemaVersion": "v2alpha1",
  "alert": "NVMe Wear Critical",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "threshold_rule",
  "disabled": false,
  "description": "NVMe drive percentage_used is above 90% — drive is near end of rated write endurance, plan replacement soon",
  "summary": "NVMe wear indicator critical on {{k8s.node.name}} ({{device}})",
  "labels": {
    "source": "gitops",
    "severity": "critical"
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "15m0s",
      "frequency": "5m0s"
    }
  },
  "notificationSettings": {
    "renotify": {
      "enabled": true,
      "interval": "4h",
      "alertStates": [
        "firing"
      ]
    },
    "usePolicy": false
  },
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "stepInterval": 300,
            "signal": "metrics",
            "source": "",
            "aggregations": [
              {
                "metricName": "smartctl_device_percentage_used",
                "temporality": "",
                "timeAggregation": "max",
                "spaceAggregation": "max",
                "reduceTo": ""
              }
            ],
            "disabled": false,
            "filter": {
              "expression": ""
            },
            "groupBy": [
              {
                "name": "k8s.node.name",
                "signal": "",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              },
              {
                "name": "device",
                "signal": "",
                "fieldContext": "attribute",
                "fieldDataType": "string"
              }
            ],
            "having": {
              "expression": ""
            },
            "legend": "{{k8s.node.name}} - {{device}}"
          }
        }
      ],
      "panelType": "graph",
      "queryType": "builder"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "critical",
          "target": 90,
          "op": "above",
          "matchType": "at_least_once",
          "channels": [
            "Email"
          ]
        }
      ]
    }
  }
}
