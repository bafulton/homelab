{
  "schemaVersion": "v2alpha1",
  "alert": "Certificate Expiring Soon",
  "alertType": "METRIC_BASED_ALERT",
  "ruleType": "promql_rule",
  "disabled": false,
  "description": "TLS certificate will expire within 7 days",
  "summary": "Certificate expiring soon",
  "labels": {
    "source": "gitops",
    "severity": "warning"
  },
  "evaluation": {
    "kind": "rolling",
    "spec": {
      "evalWindow": "5m0s",
      "frequency": "1h0m0s"
    }
  },
  "notificationSettings": {
    "renotify": {
      "enabled": false
    },
    "usePolicy": false
  },
  "condition": {
    "compositeQuery": {
      "queries": [
        {
          "type": "promql",
          "spec": {
            "name": "A",
            "query": "(certmanager_certificate_expiration_timestamp_seconds - time()) / 86400",
            "disabled": false,
            "step": 0,
            "stats": false,
            "legend": "{{namespace}}/{{name}}"
          }
        }
      ],
      "panelType": "graph",
      "queryType": "promql"
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "warning",
          "target": 7,
          "op": "below",
          "matchType": "at_least_once",
          "channels": [
            "Email"
          ]
        }
      ]
    }
  }
}
