{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track Talos version in talos/cluster.yaml",
      "fileMatch": [
        "talos/cluster\\.yaml$"
      ],
      "matchStrings": [
        "talosVersion: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track Kubernetes version in talos/cluster.yaml",
      "fileMatch": [
        "talos/cluster\\.yaml$"
      ],
      "matchStrings": [
        "kubernetesVersion: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track Talos version for Tuppr TalosUpgrade",
      "fileMatch": [
        "kubernetes/infra/tuppr/values\\.yaml$"
      ],
      "matchStrings": [
        "talosVersion: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track Kubernetes version for Tuppr KubernetesUpgrade",
      "fileMatch": [
        "kubernetes/infra/tuppr/values\\.yaml$"
      ],
      "matchStrings": [
        "kubernetesVersion: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Track argocd-diff-preview Docker image in GitHub Actions",
      "fileMatch": [
        "\\.github/workflows/.*\\.yaml$"
      ],
      "matchStrings": [
        "dagandersen/argocd-diff-preview:(?<currentValue>v[\\d\\.]+)"
      ],
      "depNameTemplate": "dagandersen/argocd-diff-preview",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track pinned versions in images/*/Dockerfile ARG lines",
      "fileMatch": [
        "^images/[^/]+/Dockerfile$"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>\\S+))?\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge minor and patch updates (after CI passes)",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Never automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Talos in its own PR, never automerge. Merging it makes tuppr roll the new version onto every node, so it must land before the matching Kubernetes bump. One PR per minor: Talos only supports upgrading one minor at a time and tuppr does not check",
      "matchPackageNames": [
        "siderolabs/talos"
      ],
      "groupName": "talos",
      "separateMultipleMinor": true,
      "automerge": false
    },
    {
      "description": "Kubernetes (cluster and the toolbox image's kubectl) in its own PR, never automerge. The talos-k8s-compatibility check fails it until the Talos bump it needs is on main. One PR per minor, as upgrade-k8s requires",
      "matchPackageNames": [
        "kubernetes/kubernetes"
      ],
      "groupName": "kubernetes",
      "separateMultipleMinor": true,
      "automerge": false
    },
    {
      "description": "Hold the python kubernetes client below v36 - auth_settings() regression: https://github.com/kubernetes-client/python/issues/2582",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "kubernetes"
      ],
      "allowedVersions": "<36"
    }
  ]
}
