.DS_Store
.idea

# Helm dependency charts (downloaded by helm dep update)
kubernetes/**/charts/
charts/**/charts/

# Helm lockfiles (except argocd which needs pinned versions)
**/Chart.lock
!kubernetes/infra/argocd/Chart.lock

# Talos generated configs contain secrets
talos/clusterconfig/
talos/secrets.yaml

# Environment file with secrets
talos/.env

# OpenTofu state files
opentofu/**/*.tfstate*
opentofu/**/.terraform/
opentofu/**/tfplan
opentofu/**/*.tfplan
memory/

# Static site build artefacts (sites/yak-shave)
sites/*/node_modules/
sites/*/dist/
sites/*/.astro/
sites/*/caddy/
