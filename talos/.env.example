# Talos Configuration Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# This file is gitignored to prevent secrets from being committed.

# Tailscale OAuth client credentials (from https://login.tailscale.com/admin/settings/oauth)
# Create an OAuth client with:
#   - Scopes: devices:core, auth_keys
#   - Tags: e.g., tag:k8s-node
# OAuth clients don't expire, making them more reliable than pre-auth keys for node authentication.
TS_CLIENT_ID=
TS_CLIENT_SECRET=

# Stable by-id disk paths for user disks (machine.disks in patches/nodes/).
# Pinning by /dev/sdX is unsafe: Longhorn's iSCSI volumes share the sd* name
# space and shift enumeration, so a replug or boot-order change can rename the
# disk and leave Talos looping on "error resolving device path".
# These live here rather than in the patches because they embed hardware
# serial numbers and the repo is public.
# Find them with: talosctl -n <node> ls /dev/disk/by-id
BEELINK_NVME_DISK=
BEELINK_USB_DISK=
RPI5_USB_DISK=
