{
  "groups": {
    "group:homelab-admins": ["fulton.benjamin@gmail.com"],
  },

  // Define grants that govern access for users, groups, autogroups, tags,
  // Tailscale IP addresses, and subnet ranges.
  "grants": [
    // User devices retain access to one another. Cluster access is explicit below.
    {
      "src": ["autogroup:member"],
      "dst": ["autogroup:member"],
      "ip": ["*"],
    },
    // Wholly administrative web interfaces share one dedicated proxy identity.
    {
      "src": ["group:homelab-admins"],
      "dst": ["tag:k8s-admin"],
      "ip": ["tcp:443"],
    },
    // Human operations for cluster nodes, the operator, CoreDNS, and the edge.
    {
      "src": ["group:homelab-admins"],
      "dst": ["tag:k8s-node", "tag:k8s-operator", "tag:k8s", "tag:edge", "tag:k8s-games"],
      "ip": ["*"],
    },
    // Household app ingress and split DNS are available to tailnet members.
    {
      "src": ["autogroup:member"],
      "dst": ["tag:k8s-apps"],
      "ip": ["tcp:80"],
    },
    // Existing CoreDNS proxy keeps tag:k8s to avoid in-place proxy retagging.
    {
      "src": ["autogroup:member", "tag:k8s-node"],
      "dst": ["tag:k8s"],
      "ip": ["udp:53", "tcp:53"],
    },
    // Cross-node pod networking over Tailscale subnet routes. Each node is the
    // subnet router for its own pod /24. The pod
    // CIDRs appear as both src and dst because --snat-subnet-routes=false keeps
    // the real pod source IP across the subnet router, so Tailscale sees pod
    // IPs - not node identities - on both ends of cross-node pod traffic.
    //
    // The whole cluster pod space (10.244.0.0/16, from cluster.network.podSubnets)
    // stands in for the per-node /24s, so adding a node needs no ACL edit - only
    // its own Talos config (advertise its /24). All these CIDRs are internal.
    //
    // 192.168.1.0/24 is the home LAN: the home nodes also advertise their own
    // node /32 so the remote node can reach the apiserver (the kubernetes
    // ClusterIP DNATs to a control-plane node's LAN IP) and any node-IP-backed
    // service. The home nodes pin this /24 to the LAN locally (see
    // subnet-route-steering), so advertising it never pulls home<->home traffic
    // onto Tailscale.
    {
      "src": ["tag:k8s-node", "10.244.0.0/16", "192.168.1.0/24"],
      "dst": ["tag:k8s-node", "10.244.0.0/16", "192.168.1.0/24"],
      "ip": ["*"],
    },
    // OCI edge forwarder: apps gateway only.
    //
    // This is the only internet-facing host on the tailnet, so it gets one
    // port. CoreDNS retains tag:k8s, but the edge has no access to it.
    //
    // 8443 is Traefik's edge listener, which accepts only the forwarder's
    // public hostname. It must not be 443: that listener serves every private
    // route, and the forwarder can't stop a client from choosing the Host
    // header after TLS. See kubernetes/infra/gateway-policies/values.yaml.
    //
    // "ip" is Tailscale's name for network-layer capability, i.e. protocol and
    // port - not an address. A bare "8443" would also grant UDP and ICMP, so
    // tcp:8443 is both tighter and clearer.
    {
      "src": ["tag:edge"],
      "dst": ["tag:k8s-apps"],
      "ip": ["tcp:8443"],
    },
    // OCI edge forwarder: game servers (opentofu/oci-forwarder var.games).
    //
    // The edge forwards plain TCP and UDP by port to tag:k8s-games
    // Tailscale Services. List exactly the ports in var.games, protocol
    // included, so this grant opens nothing the forwarder does not forward.
    {
      "src": ["tag:edge"],
      "dst": ["tag:k8s-games"],
      "ip": [
        // minecraft: the minecraft-gateway (kubernetes/apps/minecraft-gateway),
        // every Minecraft server. Java; Bedrock signaling, RakNet, NetherNet.
        "tcp:25565",
        "tcp:19132",
        "udp:19132",
        "udp:19133",
      ],
    },
  ],

  // Guard the new network boundary. No grants are inferred from DNS/Host names.
  "tests": [
    {
      "src": "fulton.benjamin@gmail.com",
      "accept": ["tag:k8s-admin:443", "tag:k8s-apps:80", "tag:k8s-node:6443", "tag:k8s:53"],
      "deny": ["tag:k8s-admin:80", "tag:k8s-admin:8080", "tag:k8s-admin:8443", "tag:k8s-apps:443"],
    },
    {
      "src": "tag:edge",
      "accept": ["tag:k8s-apps:8443", "tag:k8s-games:25565"],
      "deny": ["tag:k8s:8443", "tag:k8s-admin:443", "tag:k8s-apps:443", "tag:k8s-node:6443", "tag:k8s-games:22", "tag:k8s-games:8443"],
    },
    {
      "src": "tag:k8s-node",
      "deny": ["tag:k8s-admin:443"],
    },
  ],

  // Auto-approve each node's advertised pod-CIDR subnet route, so routes
  // self-approve on (re)provision with no console click. tag:k8s-node owns the
  // whole pod space; a node advertising any sub-/24 of it auto-approves, so a
  // new node needs no entry here (autoApprovers approve routes equal to or more
  // specific than a listed prefix).
  "autoApprovers": {
    "routes": {
      "10.244.0.0/16": ["tag:k8s-node"],
      // Home nodes advertise their own node /32 (within this LAN) so the remote
      // node can reach the apiserver / node-IP-backed services over Tailscale.
      "192.168.1.0/24": ["tag:k8s-node"],
    },
  },

  // Define users and devices that can use Tailscale SSH.
  "ssh": [
    // Allow all users to SSH into their own devices in check mode.
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"],
    },
    // Only homelab administrators may operate nodes through Tailscale SSH.
    {
      "action": "accept",
      "src": ["group:homelab-admins"],
      "dst": ["tag:k8s-node"],
      "users": ["autogroup:nonroot", "root"],
    },
    // Same for the edge forwarder, so break-glass access does not depend on
    // the OCI serial console.
    {
      "action": "accept",
      "src": ["group:homelab-admins"],
      "dst": ["tag:edge"],
      "users": ["autogroup:nonroot", "root"],
    },
  ],

  // Define tags and their owners.
  "tagOwners": {
    // Kubernetes operator manages k8s-tagged devices
    "tag:k8s-operator": [],
    "tag:k8s": ["tag:k8s-operator"],
    "tag:k8s-admin": ["tag:k8s-operator"],
    "tag:k8s-apps": ["tag:k8s-operator"],
    "tag:k8s-games": ["tag:k8s-operator"],
    // Applied to cluster nodes during bootstrap
    "tag:k8s-node": [],
    // OCI edge forwarder for public hostnames outside cloudflare (eg, jellyfin)
    "tag:edge": [],
  },
}
