# Dynamic configuration. Rendered by opentofu/oci-forwarder - do not edit here.
tcp:
  routers:
    passthrough:
      entryPoints:
        - websecure
      # Only these SNIs are forwarded; every other name is refused, so this
      # host is not a general-purpose door into the tailnet.
      rule: "${sni_rule}"
      tls:
        passthrough: true
      service: home-gateway
%{ for p in game_ports ~}
%{ if p.protocol == "tcp" ~}

    # Game server (games.tf). Plain TCP has no SNI, so HostSNI(`*`) is the
    # only rule there is: whatever arrives on this port goes to this game.
    ${p.name}:
      entryPoints:
        - ${p.name}
      rule: "HostSNI(`*`)"
      service: ${p.name}
%{ endif ~}
%{ endfor ~}

  services:
    home-gateway:
      loadBalancer:
        servers:
          - address: "${upstream}"
%{ for p in game_ports ~}
%{ if p.protocol == "tcp" ~}

    ${p.name}:
      loadBalancer:
        servers:
          - address: "${p.upstream}"
%{ endif ~}
%{ endfor ~}
%{ if length([for p in game_ports : p if p.protocol == "udp"]) > 0 ~}

udp:
  routers:
%{ for p in game_ports ~}
%{ if p.protocol == "udp" ~}
    # Game server (games.tf). UDP routers have no rule: the entrypoint is it.
    ${p.name}:
      entryPoints:
        - ${p.name}
      service: ${p.name}
%{ endif ~}
%{ endfor ~}

  services:
%{ for p in game_ports ~}
%{ if p.protocol == "udp" ~}
    ${p.name}:
      loadBalancer:
        servers:
          - address: "${p.upstream}"
%{ endif ~}
%{ endfor ~}
%{ endif ~}

http:
  routers:
    redirect-to-https:
      entryPoints:
        - web
      rule: "${host_rule}"
      middlewares:
        - to-https
      service: noop

  middlewares:
    to-https:
      redirectScheme:
        scheme: https
        permanent: true

  services:
    noop:
      loadBalancer:
        servers: []
