#cloud-config
# Rendered by opentofu/oci-forwarder. The whole host build lives here so a
# rebuild reproduces it exactly, rather than depending on anything typed in
# over SSH.

package_update: true
packages:
  - iptables-persistent
  - curl

write_files:
  - path: /etc/traefik/traefik.yml
    permissions: "0644"
    encoding: b64
    content: ${traefik_static_b64}

  - path: /etc/traefik/dynamic.yml
    permissions: "0644"
    encoding: b64
    content: ${traefik_dynamic_b64}

  - path: /etc/systemd/system/traefik.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Traefik TLS-passthrough forwarder
      Documentation=https://doc.traefik.io/traefik/
      After=network-online.target tailscaled.service
      Wants=network-online.target
      # The upstream is a MagicDNS name, so tailscaled must be up to resolve it.
      Requires=tailscaled.service

      [Service]
      Type=notify
      User=traefik
      Group=traefik
      ExecStart=/usr/local/bin/traefik --configFile=/etc/traefik/traefik.yml
      Restart=always
      RestartSec=5
      # Needed to bind 80/443 as a non-root user.
      AmbientCapabilities=CAP_NET_BIND_SERVICE
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      PrivateTmp=true
      ReadOnlyPaths=/etc/traefik

      [Install]
      WantedBy=multi-user.target

  # Dead man's switch. Every 2 minutes, request the public hostname - which
  # hairpins out through this VM's own public IP, so it exercises public DNS,
  # the security list, Traefik, the tailnet hop, home Traefik and Jellyfin -
  # and ping Healthchecks.io only if that succeeded. A failure sends nothing
  # and lets the 5-minute grace period decide, the same tolerance as the node
  # checks in kubernetes/infra/node-health.
  #
  # The ping URL is this one check's UUID URL, not a project ping-key URL: a
  # ping key can ping every check, so leaking it from the internet-facing host
  # would let someone fake "up" for beelink and rpi5 too.
  - path: /etc/edge-healthcheck.env
    permissions: "0600"
    content: |
      PING_URL=${healthcheck_ping}

  - path: /usr/local/bin/edge-healthcheck
    permissions: "0755"
    content: |
      #!/bin/sh
      curl -fsS -m 15 -o /dev/null https://${public_hostname}/health || exit 0
      curl -fsS -m 10 --retry 3 -o /dev/null "$PING_URL"

  - path: /etc/systemd/system/edge-healthcheck.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Probe the public Jellyfin path and ping the dead man's switch
      After=network-online.target traefik.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      EnvironmentFile=/etc/edge-healthcheck.env
      ExecStart=/usr/local/bin/edge-healthcheck
      DynamicUser=true

  - path: /etc/systemd/system/edge-healthcheck.timer
    permissions: "0644"
    content: |
      [Unit]
      Description=Run edge-healthcheck every 2 minutes

      [Timer]
      OnBootSec=2min
      OnUnitActiveSec=2min
      AccuracySec=10s

      [Install]
      WantedBy=timers.target

runcmd:
  # OCI's Ubuntu images carry host iptables rules that DROP everything except
  # SSH, independently of the VCN security list. Both layers must be opened or
  # the port appears open in the console while nothing can reach it.
  - iptables -I INPUT 1 -p tcp --dport 443 -j ACCEPT
  - iptables -I INPUT 1 -p tcp --dport 80 -j ACCEPT
  - iptables -I INPUT 1 -p udp --dport 41641 -j ACCEPT
  - netfilter-persistent save

  # Tailscale. --accept-dns is what makes the MagicDNS upstream resolvable;
  # without it Traefik cannot find the gateway by name.
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --authkey='${tailscale_authkey}' --accept-dns=true --advertise-tags=${tailnet_tag} --hostname=${hostname} --ssh

  # Traefik, pinned. Runs as its own unprivileged user.
  - useradd --system --no-create-home --shell /usr/sbin/nologin traefik
  - curl -fsSL -o /tmp/traefik.tar.gz https://github.com/traefik/traefik/releases/download/v${traefik_version}/traefik_v${traefik_version}_linux_amd64.tar.gz
  - tar -xzf /tmp/traefik.tar.gz -C /usr/local/bin traefik
  - chmod 0755 /usr/local/bin/traefik
  - rm -f /tmp/traefik.tar.gz
  - systemctl daemon-reload
  - systemctl enable --now traefik
  - systemctl enable --now edge-healthcheck.timer
